# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Temporary Excel & Office lock files
~$*.xlsx
~$*.xls
~$*.pptx
~$*.csv
*.tmp

# Operating System Files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Editor / IDE directories
.vscode/
.idea/

# Environment
.env
.venv
env/
venv/

# Local machine tool configs
.agents/mcp_config.json

# Pipeline authority & runtime batch metadata
.batches/
.published/
*.lock
.copq-authority.json

# Temporary deliverables and backup copies
Output/*.zip
Output/*_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]_*.pptx
scratch/
**/.backup/

# Fallback Excel & Office files from save_with_fallback
*_v[0-9]*.xlsx
*_v[0-9]*.xls
*_v[0-9]*.pptx
*.tmp.zip

# Input archives
COPQ_Input/*.zip
FTT_Input/*.zip

# Test & coverage caches
.pytest_cache/
test_out/
.coverage
htmlcov/


